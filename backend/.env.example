# Set these as environment variables before starting Spring Boot. This file is documentation, not auto-loaded.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/huongnghiep
SPRING_DATASOURCE_USERNAME=huongnghiep
SPRING_DATASOURCE_PASSWORD=replace-with-a-local-password
APP_ORIGIN=http://localhost:5173
# Existing repository data is illustrative/unverified. Enable only for development.
SEED_ENABLED=true
COOKIE_SECURE=false
# Opt-in one-time local administrator; no default password. Disable after initial creation.
LOCAL_ADMIN_ENABLED=false
LOCAL_ADMIN_USERNAME=
LOCAL_ADMIN_PASSWORD=
